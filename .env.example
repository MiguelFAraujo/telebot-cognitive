# Gateway
OMNIROUTE_URL=http://127.0.0.1:20128/v1/chat/completions
OMNIROUTE_KEY=

# Models (fallback chain, priority order)
AGENT_MODELS=openai/gpt-4o-mini,google/gemini-flash,anthropic/claude-haiku

# Identity
AGENT_MARKER=Assistant

# Paths
EVENT_DIR=./events
AGENT_STATE_DB=./state/agent.db
AGENT_AUDIT_LOG=./state/agent_audit.jsonl
KNOWLEDGE_DIR=./knowledge

# Safety: start with dry-run, then approval, only then live
AGENT_SEND_ENABLED=false
AGENT_APPROVAL_MODE=false
AGENT_APPROVAL_CHAT_ID=

# Telegram sending (required only when SEND_ENABLED=true)
TELEGRAM_SESSION=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Limits
AGENT_MIN_CONFIDENCE=0.82
AGENT_GROUP_COOLDOWN_SECONDS=5400
AGENT_GROUP_DAILY_CAP=3
AGENT_GLOBAL_DAILY_CAP=20
AGENT_LOOP_SECONDS=120
AGENT_LOOKBACK_MINUTES=12
AGENT_MAX_REPLIES_CYCLE=2
AGENT_LEARNING_DAILY_CAP=30
AGENT_QUIET_START=22
AGENT_QUIET_END=8
